{
  "manifest_version": 3,
  "name": "TabFlow - 垂直标签与智能分组",
  "version": "1.2.1",
  "version_name": "1.2.1 ChatGPT plan prototype",
  "minimum_chrome_version": "120",
  "description": "在 Chrome 侧边栏管理标签与分组，整合书签和稍后读，支持本地规则及可选 AI 分类。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "tabGroups",
    "storage",
    "favicon",
    "bookmarks",
    "readingList",
    "contextMenus",
    "nativeMessaging",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["oauth-callback.html"],
      "matches": ["http://127.0.0.1/*", "https://auth.openai.com/*"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "打开 TabFlow 侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_side_panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "打开/关闭 TabFlow 侧边栏"
    },
    "open_popup_window": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "以独立窗口打开 TabFlow"
    }
  },
  "key": ""
}